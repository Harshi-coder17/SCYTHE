# Template only. Copy to .env.production, replace every placeholder with a
# distinct value from your production secret manager, then pass --env-file.
# Generate each secret independently with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the populated .env.production file.

SCYTHE_PUBLIC_HOST=replace-with-real-hostname.example
SCYTHE_PUBLIC_ORIGIN=https://replace-with-real-hostname.example

SCYTHE_DB_PASSWORD=REPLACE_WITH_DISTINCT_64_HEX_CHAR_SECRET
POSTGRES_ROOT_PASSWORD=REPLACE_WITH_DISTINCT_64_HEX_CHAR_SECRET
REDIS_PASSWORD=REPLACE_WITH_DISTINCT_64_HEX_CHAR_SECRET
REDIS_SECURITY_PASSWORD=REPLACE_WITH_DISTINCT_64_HEX_CHAR_SECRET
SANDBOX_RUNNER_SECRET=REPLACE_WITH_DISTINCT_64_HEX_CHAR_SECRET
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_64_HEX_CHAR_SECRET

ENVIRONMENT=production
REQUIRE_REAL_CERT=true
SHADOW_SCORING_ENABLED=false
