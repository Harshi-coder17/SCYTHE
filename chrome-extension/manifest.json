{
  "manifest_version": 3,
  "name": "SCYTHE Threat Shield",
  "version": "1.0.0",
  "description": "SCYTHE (Secure Cyber & Threat Heuristic Engine) — Real-time AI-powered phishing and threat detection. Scans every page you visit and warns you before you interact with dangerous sites.",

  "icons": {
    "16":  "icons/default_logo_16.png",
    "32":  "icons/default_logo_32.png",
    "48":  "icons/default_logo_48.png",
    "128": "icons/default_logo_128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "SCYTHE Threat Shield",
    "default_icon": {
      "16":  "icons/default_logo_16.png",
      "32":  "icons/default_logo_32.png",
      "48":  "icons/default_logo_48.png",
      "128": "icons/default_logo_128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "bdr.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "webNavigation"
  ],

  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}