{
  "manifest_version": 3,
  "name": "SCYTHE Threat Shield",
  "version": "1.0.0",
  "description": "SCYTHE \u2014 scans visited pages and displays available threat evidence. Browser navigation is not synchronously blocked while analysis runs.",
  "icons": {
    "16": "icons/default_logo_16.png",
    "32": "icons/default_logo_32.png",
    "48": "icons/default_logo_48.png",
    "128": "icons/default_logo_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SCYTHE Threat Shield",
    "default_icon": {
      "16": "icons/default_logo_16.png",
      "32": "icons/default_logo_32.png",
      "48": "icons/default_logo_48.png",
      "128": "icons/default_logo_128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "config.js",
        "auth-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "bdr.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
