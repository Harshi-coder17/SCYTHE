# ============================================================
# SCYTHE Backend - Environment Configuration Template
# Copy this file to .env and fill in all required values
# before running: docker-compose up --build
# ============================================================

# Application
APP_NAME=SCYTHE Backend
DEBUG=false
ENVIRONMENT=production

# Auth / JWT
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_32_byte_hex_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=scythe-auth-v1

# Database
POSTGRES_USER=scythe
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=scythe_db
DATABASE_URL=postgresql://scythe:CHANGE_ME_strong_db_password@postgres:5432/scythe_db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_SECURITY_URL=redis://redis_security:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Shared Storage (cross-container scan artifacts)
SHARED_DIR=/shared/scans
EMAIL_SHARED_DIR=/shared/scans

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=true

# Sandbox Runner
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SANDBOX_RUNNER_SECRET=CHANGE_ME_sandbox_runner_shared_secret
SANDBOX_IMAGE=scythe-sandbox@sha256:c10140e89411622b4c6331e440690d186f5b7c9f279cf1d88c589379763ac54c
MOBILECLIP_ENABLED=false
# Optional experimental visual model. Leave disabled until the checkpoint,
# upstream vendor source, classifier artifact, and CPU inference dependencies
# are installed and reviewed together.
MOBILECLIP_ARTIFACT_DIR=models/mobileclip
MOBILECLIP_CHECKPOINT_PATH=
MOBILECLIP_VENDOR_DIR=
SANDBOX_NETWORK=scythe_sandbox_net
SHARED_SCANS_VOLUME=scythe_shared_scans

# Risk Score Thresholds
SAFE_THRESHOLD=20
LOW_THRESHOLD=40
MEDIUM_THRESHOLD=60
HIGH_THRESHOLD=80

# CORS and Security
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# Threat Intelligence APIs (optional - system degrades gracefully)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# GOOGLE_SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here
# IPQUALITYSCORE_API_KEY=your_ipqs_api_key_here

# Alerting (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Backup
BACKUP_DIR=/backups

# LightGBM Model (optional - falls back to placeholder scorer)
# LIGHTGBM_MODEL_PATH=/app/models/risk_model.pkl

# Validated release: use the isolated `models` worker profile and a passing
# immutable release bundle. The deprecated pickle path does not activate it.
MODEL_RELEASE_ENABLED=false
MODEL_RELEASE_BUNDLE_DIR=/opt/scythe/release
MODEL_RELEASE_CHECKSUMS_SHA256=
MODEL_ENCODER_SOURCE_DIR=/opt/scythe/mobileclip-dataset

# Superuser Emails (optional)
# SUPERUSER_EMAILS=admin@yourdomain.com
