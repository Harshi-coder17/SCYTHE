# ===================================================
# SCYTHE Celery Worker Container
# Stage 1: Build deps (cached layer)
# Stage 2: Runtime image — non-root, hardened, includes docker-cli
# ===================================================

FROM postgres:16-bookworm@sha256:0ea6700a3b4f0ae6ce746519073558aed4d88a79d8d07622a9a644946c7319c4 AS pgtools

FROM python:3.11-slim@sha256:b7a9e5f6a93d6d4a31f129bbd4bdee69efccb6ded0fb230d78aafaf37af98377 AS builder
WORKDIR /app
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.11-slim@sha256:b7a9e5f6a93d6d4a31f129bbd4bdee69efccb6ded0fb230d78aafaf37af98377 AS runtime
RUN groupadd --gid 10001 scythe \
    && useradd --uid 10001 --gid scythe --shell /bin/bash --create-home scythe
WORKDIR /app

# Celery worker processes OCR, computer vision, and machine learning models.
# It no longer requires docker-cli or access to docker_socket_proxy (Critical Finding #1).
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    libpq5 libgomp1 liblz4-1 libzstd1 zlib1g tesseract-ocr libzbar0 openssl gosu \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
COPY --from=pgtools /usr/lib/postgresql/16/bin/pg_dump /usr/lib/postgresql/16/bin/pg_restore /usr/local/bin/
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1 setuptools==84.0.0 wheel==0.48.0 \
    && python -m pip uninstall -y pip
COPY --chown=scythe:scythe . .

# Ensure app, shared, and backup directories exist with read/write permissions for scythe user
RUN mkdir -p /app /shared/scans /backups /app/models /app/celerybeat-schedule \
    && chown -R scythe:scythe /app /shared /backups \
    && chmod -R 0775 /app /shared \
    && chmod 0750 /backups
VOLUME ["/shared/scans"]
VOLUME ["/backups"]

COPY --chown=scythe:scythe celery_entrypoint.sh /app/celery_entrypoint.sh
RUN chmod +x /app/celery_entrypoint.sh

USER scythe

# Celery health check
HEALTHCHECK --interval=45s --timeout=15s --start-period=30s --retries=3 \
    CMD celery -A celery_worker inspect ping --timeout 5 2>&1 | grep -c pong || exit 1

ENTRYPOINT ["/app/celery_entrypoint.sh"]
